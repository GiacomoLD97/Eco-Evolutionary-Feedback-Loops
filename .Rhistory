#Improved
# Define categories and habits
practices <- c("Consume", "Create", "Learn", "Move", "Reflect")
Consume <- c("Watch TV", "Play Videogames")
Create <- c("Cook", "Edit Photos", "Draw")
Learn <- c("Podcast", "Language Practice", "Read")
Move <- c("Strength work", "Running", "Yoga/Mobility")
Reflect <- c("Journal", "Sitting Meditation", "Walking Meditation")
week <- c("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
# Map practices to their habit options
habit_options <- list(
Consume = Consume,
Create = Create,
Learn = Learn,
Move = Move,
Reflect = Reflect
)
set.seed(Sys.time())  # ensure new randomness each run
# Generate and print habits for each day
for (day in week) {
# Randomly select 3 distinct practices
todays_practices <- sample(practices, size = 3)
# Randomly select one habit per practice
todays_habits <- sapply(todays_practices, function(p) sample(habit_options[[p]], 1))
# Create a nicely formatted output
daily_plan <- paste(paste0(todays_practices, " – ", todays_habits), collapse = ", ")
cat(day, ":", daily_plan, "\n")
}
practices <- c("Consume", "Create", "Learn", "Move", "Reflect")
numbers <- 1:5
Consume <- c("Watch TV", "Play Videogames")
Create <- c("Cook", "Edit Photos", "Draw")
Learn <- c("Podcast", "Language Practice", "Read")
Move <- c("Strength work", "Running", "Yoga/Mobility")
Reflect <- c("Journal", "Sitting Meditation", "Walking Meditation")
selection <- sample(x = numbers, size = 3)
habit <- sample(x = selection, size = 3)
week <- c("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
for (day in week) {
selection <- sample(x = practices, size = 3)
if (day == "Monday") {
for (x in 1:3) {
if (selection[x] == "Consume") {
habit[x] <- sample(x = Consume, size = 1)
} else if (selection[x] == "Create") {
habit[x] <- sample(x = Create, size = 1)
} else if (selection[x] == "Learn") {
habit[x] <- sample(x = Learn, size = 1)
} else if (selection[x] == "Move") {
habit[x] <- sample(x = Move, size = 1)
} else if (selection[x] == "Reflect") {
habit[x] <- sample(x = Reflect, size = 1)
}
}
